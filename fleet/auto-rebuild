#!/usr/bin/env bash
# Unattended fleet update, one machine at a time, once a day.
#
#   pull -> lint -> commit (local work only) -> switch -> verify -> push
#
# The fleet shares one branch, so the push rule is the whole point of this
# script: a host whose only changes arrived by `git pull` publishes nothing and
# never answers for another machine's commit. A host with edits of its own
# commits and pushes them, exactly like an interactive `rebuild` would.
#
# Ordering is deliberate. Local edits are committed *before* the switch, so the
# generation that goes live and the commit that may get pushed describe the same
# tree. (An interactive `rebuild` switches first and commits afterwards, so an
# edit made there only becomes live on the second run. That is a separate
# question; do not "simplify" this script into that order.)
#
# Lint failures warn instead of aborting. A host that refuses to update because
# a cosmetically unformatted file landed on main is a worse outcome than a
# slightly untidy repo, and a broken configuration is refused by the evaluator
# anyway.
#
# Tunables, all environment variables so the systemd unit stays declarative:
#   AUTO_REBUILD_PULL=0                     skip the pull, rebuild what is here
#   AUTO_REBUILD_MODE=boot|build|switch     what nixos-rebuild does (switch)
#   AUTO_REBUILD_WHEN_USER_SESSION=boot|skip|switch
#                                           what to do while a desktop is in use
#   AUTO_REBUILD_UPDATE_INPUTS=1            refresh flake.lock first (one host only)
#   AUTO_REBUILD_CRITICAL_UNITS="a b"       roll back if these are not active
#   AUTO_REBUILD_LINT_CHECKS="a b"          which flake checks to run
set -euo pipefail

readonly repo=/etc/nixos
host="$(hostname)"
readonly host
readonly pull_enabled="${AUTO_REBUILD_PULL:-1}"
rebuild_mode="${AUTO_REBUILD_MODE:-switch}"
# Defaults to boot, not skip: a unit from an older generation does not set this
# yet, and skip would keep that old unit in place forever on a desktop that is
# never logged out.
readonly session_mode="${AUTO_REBUILD_WHEN_USER_SESSION:-boot}"
readonly update_inputs_enabled="${AUTO_REBUILD_UPDATE_INPUTS:-0}"
session_busy=0
readonly critical_units="${AUTO_REBUILD_CRITICAL_UNITS:-tailscaled}"
readonly lint_checks="${AUTO_REBUILD_LINT_CHECKS:-formatting statix deadnix shellcheck}"
readonly runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# rebuild.sh takes its own lock from here too, so both live in one directory.
export XDG_RUNTIME_DIR="$runtime_dir"

log() {
  printf '%s auto-rebuild[%s]: %s\n' "$(date -Is)" "$host" "$*"
}

die() {
  log "ERROR: $*" >&2
  exit 1
}

# The systemd unit spells booleans the Nix way ("true"/"false"); a hand-run
# from a shell is more likely to say 1. Accept both rather than have one of them
# silently mean the opposite of what it says.
truthy() {
  case "${1,,}" in
    1 | true | yes) return 0 ;;
    *) return 1 ;;
  esac
}

# Anything a `loginctl`-capable machine could be using. A timer that skips a
# desktop mid-session avoids switching a live compositor's world out from under
# it; on a headless box no such session exists and the check never fires.
graphical_session_active() {
  local session state type
  while read -r session; do
    state="$(loginctl show-session "$session" -p Active --value 2>/dev/null || true)"
    [[ $state == yes ]] || continue
    type="$(loginctl show-session "$session" -p Type --value 2>/dev/null || true)"
    case $type in
      x11 | wayland | mir) return 0 ;;
    esac
  done < <(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}')
  return 1
}

tree_clean() {
  git diff --quiet &&
    git diff --cached --quiet &&
    [[ -z "$(git ls-files --others --exclude-standard)" ]]
}

unpushed_commits() {
  git rev-parse --quiet --verify '@{upstream}' >/dev/null || return 0
  git log --oneline '@{upstream}..HEAD'
}

# `path:` rather than a bare `$repo#attr` on purpose: this run may be acting on
# edits that are not committed yet, and a git flake ref would evaluate HEAD.
# The attribute is bare: nixos-rebuild appends .config.system.build.nixos-rebuild
# to whatever comes after the #.
flake_ref() {
  printf 'path:%s#%s' "$repo" "$host"
}

# Fold in what other hosts pushed, so the push at the end is a fast-forward.
#
# This started life as a plain `git pull --ff-only`, which cannot do this job:
# it is skipped when the tree is dirty, and it *fails* as soon as the local
# branch has commits of its own, which is exactly the case that needs
# publishing. On a fleet that shares one branch, every host with local work hit
# that failure, and because this runs unattended nobody saw it: the push was
# rejected and the work stayed on the host until a human noticed.
#
# Called with a dirty tree the merge cannot run, so the caller skips it and the
# push below handles the rejection instead.
integrate_origin() {
  local branch upstream
  branch="$(git symbolic-ref --quiet --short HEAD)" ||
    die "detached HEAD, cannot integrate"

  if ! tree_clean; then
    log "working tree is dirty, leaving origin alone"
    return 0
  fi

  if ! git fetch --quiet origin "$branch"; then
    log "git fetch failed; the push may be rejected"
    return 0
  fi

  upstream="$(git rev-parse --quiet --verify '@{upstream}' 2>/dev/null)" || return 0
  git merge-base --is-ancestor "$upstream" HEAD && return 0

  log "merging origin/$branch into $branch"
  if GIT_MERGE_AUTOEDIT=no git merge --no-edit "$upstream"; then
    return 0
  fi

  # A conflict leaves both sides intact and touches nothing: the tree is clean,
  # the merge is aborted, and the host keeps the commits it authored. The push
  # then fails loudly, which is the correct outcome for a conflict.
  git merge --abort 2>/dev/null || true
  log "ERROR: could not merge origin/$branch cleanly; aborted, nothing pushed"
  return 1
}

pull_changes() {
  if ! tree_clean; then
    log "working tree has local changes, not pulling"
    return 0
  fi
  # Best effort only. A divergent branch is not an error here: integrate_origin
  # deals with it, and it runs after the commit, when the tree is clean.
  if ! git pull --ff-only; then
    log "could not fast-forward from origin; continuing with the local tree"
  fi
}

# Refresh flake.lock, and keep it only if every host still evaluates and this
# host's system builds. A broken upstream then costs one log line instead of a
# fleet that cannot rebuild.
update_inputs() {
  local hosts name
  if ! tree_clean; then
    log "working tree has local changes, not updating inputs"
    return 0
  fi
  if ! nix flake update; then
    log "WARNING: nix flake update failed; keeping the old lock"
    git checkout -- flake.lock
    return 0
  fi
  if git diff --quiet -- flake.lock; then
    log "flake inputs already up to date"
    return 0
  fi

  if ! hosts="$(nix eval --raw "path:$repo#nixosConfigurations" \
    --apply 'c: builtins.concatStringsSep " " (builtins.attrNames c)')"; then
    log "WARNING: could not list hosts with the new lock; reverting it"
    git checkout -- flake.lock
    return 0
  fi
  for name in $hosts; do
    if ! nix eval --raw "path:$repo#nixosConfigurations.$name.config.system.build.toplevel.drvPath" >/dev/null; then
      log "WARNING: $name does not evaluate with the new lock; reverting it"
      git checkout -- flake.lock
      return 0
    fi
  done
  if ! nix build --no-link "path:$repo#nixosConfigurations.$host.config.system.build.toplevel"; then
    log "WARNING: $host does not build with the new lock; reverting it"
    git checkout -- flake.lock
    return 0
  fi

  git commit -q -m "chore(flake): update inputs (auto-rebuild on ${host})" -- flake.lock
  log "updated flake inputs as $(git rev-parse --short HEAD)"
}

lint() {
  local arch check
  arch="$(nix eval --raw --impure --expr builtins.currentSystem)"
  for check in $lint_checks; do
    if ! nix build --no-link "path:$repo#checks.$arch.$check"; then
      log "WARNING: check '$check' failed; continuing, the evaluator still guards the switch"
    fi
  done
}

commit_local_changes() {
  if tree_clean; then
    return 1
  fi
  git add -A
  git commit -q -m "chore(${host}): auto-rebuild $(date '+%Y-%m-%d %H:%M')"
  log "committed local changes as $(git rev-parse --short HEAD)"
  return 0
}

switch_system() {
  sudo nixos-rebuild "$rebuild_mode" --flake "$(flake_ref)" ||
    die "nixos-rebuild $rebuild_mode failed; the running system was not changed"
  if [[ $rebuild_mode == boot ]]; then
    log "staged $(readlink -f /nix/var/nix/profiles/system) for the next boot"
    return 0
  fi
  if [[ "$(readlink -f /nix/var/nix/profiles/system)" != "$(readlink -f /run/current-system)" ]]; then
    die "generation is not live; run: sudo nixos-rebuild switch --profile /nix/var/nix/profiles/system"
  fi
}

# The switch has already returned, so a unit it broke is visible now, while this
# script is still running locally. Undo the change instead of waiting for a
# human who is not at the machine.
verify_critical_units() {
  local unit
  # Nothing went live in boot or build mode, so there is nothing to verify.
  [[ $rebuild_mode == switch ]] || return 0
  for unit in $critical_units; do
    systemctl is-active --quiet "$unit" && continue
    log "ERROR: $unit is not active after the switch, rolling back"
    if sudo nixos-rebuild switch --rollback; then
      log "rolled back to $(readlink -f /run/current-system)"
    else
      log "ERROR: rollback failed, this host needs hands on" >&2
    fi
    die "$unit did not come back up"
  done
}

publish_local_commits() {
  local branch pending attempt
  branch="$(git symbolic-ref --quiet --short HEAD)" ||
    die "detached HEAD, not pushing"
  pending="$(unpushed_commits)"
  if [[ -z $pending ]]; then
    log "nothing new authored here, not pushing"
    return 0
  fi
  log "pushing $(wc -l <<<"$pending") local commit(s) to $(git remote get-url origin)"

  # Retry once after integrating: another host can push in the gap between this
  # host's fetch and its push, and a plain rejection used to strand the work.
  for attempt in 1 2; do
    if git push origin "${branch}:refs/heads/${branch}"; then
      return 0
    fi
    if ((attempt == 1)); then
      log "push rejected; integrating origin and retrying once"
      integrate_origin || true
    fi
  done

  # Loud on failure: the system is already updated at this point, so a silent
  # warning here is how unpushed work disappears for a week.
  die "git push failed after retrying; the system is updated but these commits are local only"
}

# The run can take half an hour, so with someone at the keyboard an edit
# started after the first check must not be committed or staged either.
leave_if_edited() {
  if ((session_busy)) && ! tree_clean; then
    log "$repo gained uncommitted edits during the run, leaving it alone"
    exit 0
  fi
}

main() {
  local lock="$runtime_dir/auto-rebuild.lock"

  cd "$repo"

  install -d -m 0700 "$runtime_dir"
  exec 9>"$lock"
  if ! flock -n 9; then
    log "another auto-rebuild holds $lock, skipping"
    exit 0
  fi

  if [[ $rebuild_mode == switch ]] && graphical_session_active; then
    case $session_mode in
      skip)
        log "a graphical session is active, leaving this host alone"
        exit 0
        ;;
      boot)
        # Someone at the keyboard may be halfway through an edit here, and the
        # commit step would publish it. Only an idle checkout is fair game.
        if ! tree_clean; then
          log "a graphical session is active and $repo has uncommitted edits, leaving it alone"
          exit 0
        fi
        log "a graphical session is active, staging the update for the next boot"
        rebuild_mode=boot
        session_busy=1
        ;;
      switch) ;;
      *) die "unknown AUTO_REBUILD_WHEN_USER_SESSION=$session_mode" ;;
    esac
  fi
  readonly rebuild_mode session_busy

  log "starting at $(git log -1 --oneline)"

  if truthy "$pull_enabled"; then
    pull_changes
  else
    log "pull disabled (AUTO_REBUILD_PULL=$pull_enabled)"
  fi

  lint

  leave_if_edited
  commit_local_changes || true

  # After the commit and before the switch, so the tree is clean and the
  # generation that goes live is built from the merged result rather than from a
  # branch the push is about to be rejected for.
  integrate_origin || true

  # After the merge, so the lock is validated against the tree that gets built.
  if truthy "$update_inputs_enabled"; then
    update_inputs
  fi

  leave_if_edited
  switch_system
  verify_critical_units
  publish_local_commits

  if [[ $rebuild_mode == boot ]]; then
    log "done, next boot is $(readlink -f /nix/var/nix/profiles/system)"
  else
    log "done, live system is $(readlink -f /run/current-system)"
  fi
}

main "$@"
