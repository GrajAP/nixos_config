set -euo pipefail

bluetoothctl power on >/dev/null

mapfile -t devices < <(bluetoothctl devices Paired)
if ((${#devices[@]} == 0)); then
  mapfile -t devices < <(bluetoothctl devices)
fi

if ((${#devices[@]} == 0)); then
  notify-send -u normal -t 2500 "Bluetooth" "No known devices found."
  exit 0
fi

if ((${#devices[@]} == 1)); then
  selected="${devices[0]}"
else
  selected="$(printf '%s\n' "${devices[@]}" | sed 's/^Device //' | fuzzel --dmenu --prompt='Bluetooth: ' || true)"
  [[ -n "$selected" ]] || exit 0
  selected="Device $selected"
fi

mac="$(awk '{print $2}' <<<"$selected")"
name="$(cut -d' ' -f3- <<<"$selected")"
connected="$(bluetoothctl info "$mac" | awk '/Connected:/ {print $2; exit}')"

if [[ "$connected" == "yes" ]]; then
  if bluetoothctl disconnect "$mac" >/dev/null; then
    notify-send -t 2000 "Bluetooth" "Disconnected: $name"
  else
    notify-send -u critical -t 3000 "Bluetooth" "Could not disconnect: $name"
    exit 1
  fi
else
  if bluetoothctl connect "$mac" >/dev/null; then
    notify-send -t 2000 "Bluetooth" "Connected: $name"
  else
    notify-send -u critical -t 3000 "Bluetooth" "Could not connect: $name"
    exit 1
  fi
fi
