  TXT_PATH="$txt_file" WAV_REQUEST="$wav" WHISPR_SOCK="$serve_sock" WHISPER_STATS_PATH="$stats_file" python3 - <<'PY' && return 0
import json
import os
import socket
import sys

wanted = [
    "WHISPER_LANGUAGE",
    "WHISPER_LANGS",
    "WHISPER_MODEL",
    "WHISPER_BEAM_SIZE",
    "WHISPER_DUAL",
    "WHISPER_MIN_SCORE",
    "WHISPER_VAD",
    "DICT_PATH",
