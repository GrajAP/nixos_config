review_text_popup() {
  local initial_text="$1"
  local output_file="$state_dir/review.out"

  rm -f "$output_file" "$review_err"
  ensure_ui_css
  printf '%s' "$initial_text" >"$output_file"

  if ! command -v yad >/dev/null 2>&1; then
    printf '%s' "$initial_text"
    return 0
  fi

  if yad --text-info \
    --editable \
    --filename="$output_file" \
    --in-place \
    --title="Whispr Flow" \
    --text="Edit the transcription, then click Paste to type it under your cursor." \
    --width=860 \
    --height=320 \
    --center \
    --on-top \
    --fixed \
    --sticky \
    --undecorated \
    --skip-taskbar \
    --window-type=dialog \
    --borders=16 \
    --wrap \
    --margins=12 \
    --css="$review_css_file" \
    --button="Cancel:1" \
    --button="Paste:0" \
    >/dev/null 2>"$review_err"; then
    cat "$output_file"
    return 0
  fi

  return 1
}

cleanup_stale_pid() {
  if [[ -f "$pid_file" ]]; then
    local pid
    pid=$(cat "$pid_file" 2>/dev/null || true)
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
    rm -f "$pid_file"
  fi
}

get_default_source() {
  if command -v pactl >/dev/null 2>&1; then
    pactl get-default-source 2>/dev/null || true
  fi
}

list_source_candidates() {
  pw-dump 2>/dev/null | jq -r '
    [
      .[]
      | select(.type == "PipeWire:Interface:Node")
      | .info.props as $props
      | select($props["media.class"] == "Audio/Source")
      | select(($props["node.name"] // "") != "")
      | {
          name: $props["node.name"],
          score: (
            ($props["priority.session"] // 0)
            + (if (($props["node.description"] // "") | test("input 1 mic|microphone|\\bmic\\b"; "i")) then 5000 else 0 end)
            - (if (($props["node.name"] // "") | test("camera|webcam"; "i")) then 10000 else 0 end)
          )
        }
    ]
    | sort_by([-.score, .name])
    | .[].name
  ' 2>/dev/null || true
}

source_is_available() {
  local source_name="$1"

  pw-dump 2>/dev/null \
    | jq -e --arg source "$source_name" '
      [
        .[]
        | select(.type == "PipeWire:Interface:Node")
        | .info.props as $props
        | select($props["media.class"] == "Audio/Source")
        | $props["node.name"] // empty
      ]
      | any(. == $source)
    ' >/dev/null 2>&1
}

select_record_source() {
  local requested_source="${WHISPER_SOURCE:-}"
  local cached_source
  local default_source
  local source_name
  local -A seen=()
  local candidates=()

  cached_source="$(cat "$source_cache_file" 2>/dev/null || true)"
  default_source="$(get_default_source)"
  [[ -n "$requested_source" ]] && candidates+=("$requested_source")
  [[ -n "$cached_source" ]] && candidates+=("$cached_source")
  [[ -n "$default_source" ]] && candidates+=("$default_source")
  while IFS= read -r source_name; do
    [[ -n "$source_name" ]] && candidates+=("$source_name")
  done < <(list_source_candidates)

  for source_name in "${candidates[@]}"; do
    [[ -n "${seen[$source_name]:-}" ]] && continue
    seen[$source_name]=1
    if source_is_available "$source_name"; then
      printf '%s\n' "$source_name" >"$source_cache_file"
      printf '%s\n' "$source_name"
      return 0
    fi
    printf 'source_unavailable: %s\n' "$source_name" >>"$record_log"
  done

  return 1
}

ensure_source_unmuted() {
  local src="$1"
  if [[ -n "${src:-}" ]] && command -v pactl >/dev/null 2>&1; then
    pactl set-source-mute "$src" 0 >/dev/null 2>&1 || true
  fi
}

ensure_learn_script() {
  cat >"$learn_script" <<'PY'
#!/usr/bin/env python3
import difflib
import os
import re
from pathlib import Path

transcript = os.environ.get("TRANSCRIPT", "")
clip = os.environ.get("CLIP", "")
dict_path = Path(os.environ.get("DICT_PATH", ""))
corrections_path = Path(os.environ.get("CORRECTIONS_PATH", ""))
log_path = Path(os.environ.get("DICT_LOG", ""))

def words(s: str):
    return re.findall(r"[0-9A-Za-zĄąĆćĘęŁłŃńÓóŚśŹźŻż][0-9A-Za-zĄąĆćĘęŁłŃńÓóŚśŹźŻż'+.-]*", s)

def normalize_word(s: str):
    return re.sub(r"\s+", " ", s).strip().casefold()

def load_existing_lines(path: Path):
    if not path.exists():
        return []
    return [ln.strip() for ln in path.read_text(encoding="utf-8").splitlines() if ln.strip()]

def choose_dictionary_terms(tokens):
    learned = []
    for token in tokens:
        if len(token) <= 2:
            continue
        if token.isdigit():
            continue
        if any(ch.isupper() for ch in token) or re.search(r"[0-9_-]", token):
            learned.append(token)
    return learned

def learn_capitalization_preferences(src_words, dst_words):
    matcher = difflib.SequenceMatcher(a=[w.casefold() for w in src_words], b=[w.casefold() for w in dst_words])
    pairs = []
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag != "equal":
            continue
        left = src_words[i1:i2]
        right = dst_words[j1:j2]
        for wrong, correct in zip(left, right):
            if wrong == correct:
                continue
            if wrong.casefold() != correct.casefold():
                continue
            if not any(ch.isupper() for ch in correct):
                continue
            pairs.append((wrong, correct))
    return pairs

def learn_replacements(src_words, dst_words):
    matcher = difflib.SequenceMatcher(a=[w.casefold() for w in src_words], b=[w.casefold() for w in dst_words])
    pairs = []
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag != "replace":
            continue
        left = src_words[i1:i2]
        right = dst_words[j1:j2]
        if not left or not right:
            continue
        if len(left) > 5 or len(right) > 5:
            continue
        wrong = " ".join(left).strip()
        correct = " ".join(right).strip()
        if normalize_word(wrong) == normalize_word(correct):
            continue
        pairs.append((wrong, correct))
    return pairs

t_words = words(transcript)
c_words = words(clip)

if not t_words or not c_words:
    raise SystemExit(0)

t_set = {w.casefold() for w in t_words}
c_set = {w.casefold() for w in c_words}

overlap = len(t_set & c_set) / max(1, len(t_set))
len_ok = 0.5 <= (len(clip) / max(1, len(transcript))) <= 2.0

if overlap < 0.3 or not len_ok:
    raise SystemExit(0)

new_words = []
for w in c_words:
    if w.casefold() not in t_set or any(ch.isupper() for ch in w) or re.search(r"[0-9_-]", w):
        new_words.append(w)

replacement_pairs = learn_replacements(t_words, c_words)
replacement_pairs.extend(learn_capitalization_preferences(t_words, c_words))
dictionary_terms = choose_dictionary_terms(new_words + [item for _wrong, correct in replacement_pairs for item in words(correct)])

dict_entries = set(load_existing_lines(dict_path))
for w in dictionary_terms:
    dict_entries.add(w)

if dict_entries:
    dict_path.parent.mkdir(parents=True, exist_ok=True)
    dict_path.write_text("\n".join(sorted(dict_entries, key=str.casefold)), encoding="utf-8")

corrections = {}
for line in load_existing_lines(corrections_path):
    if "\t" not in line:
        continue
    wrong, correct = line.split("\t", 1)
    if wrong.strip() and correct.strip():
        corrections[normalize_word(wrong)] = (wrong.strip(), correct.strip())

for wrong, correct in replacement_pairs:
    corrections[normalize_word(wrong)] = (wrong, correct)

if corrections:
    corrections_path.parent.mkdir(parents=True, exist_ok=True)
    ordered = sorted(corrections.values(), key=lambda item: (-len(item[0].split()), item[0].casefold(), item[1].casefold()))
    corrections_path.write_text("\n".join(f"{wrong}\t{correct}" for wrong, correct in ordered), encoding="utf-8")

try:
    if log_path:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with log_path.open("a", encoding="utf-8") as fh:
            if replacement_pairs:
                fh.write("corrections: " + "; ".join(f"{wrong} -> {correct}" for wrong, correct in replacement_pairs) + "\n")
            if dictionary_terms:
                fh.write("dictionary: " + ", ".join(dictionary_terms) + "\n")
except Exception:
    pass
PY
  chmod 700 "$learn_script"
}

daemon_probe() {
  python3 - "$serve_sock" <<'PY' >/dev/null 2>&1
import socket
import sys

client = socket.socket(socket.AF_UNIX)
client.settimeout(0.5)
try:
    client.connect(sys.argv[1])
except OSError:
    raise SystemExit(1)
finally:
    client.close()
PY
}

warmup_asr() {
  (
    if ! daemon_probe; then
      WHISPR_SERVE_SOCK="$serve_sock" \
        WHISPER_MODEL="${WHISPER_MODEL:-large-v3-turbo}" \
        WHISPER_BEAM_SIZE="${WHISPER_BEAM_SIZE:-5}" \
        WHISPER_DUAL="${WHISPER_DUAL:-1}" \
        WHISPER_MIN_SCORE="${WHISPER_MIN_SCORE:--0.47}" \
        WHISPER_VAD="${WHISPER_VAD:-1}" \
        WHISPER_LANGS="${WHISPER_LANGS:-pl,en}" \
        DICT_PATH="$dict_file" \
        CORRECTIONS_PATH="$corrections_file" \
        WHISPER_LOG_PATH="$data_dir/whisper.log" \
        WHISPER_FAILED_DIR="$data_dir/failed" \
        nohup python3 "$asr_py" serve >>"$serve_log" 2>&1 &
    fi
  ) >/dev/null 2>&1 &
  return 0
}

stop_partials() {
  local pid
  pid="$(cat "$partials_pid_file" 2>/dev/null || true)"
  if [[ -n "${pid:-}" ]]; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$partials_pid_file"
}

asr_partial() {
  local wav="$1"
  WAV_REQUEST="$wav" WHISPR_SOCK="$serve_sock" WHISPER_PARTIAL_TAIL="${WHISPER_PARTIAL_TAIL:-8}" python3 - <<'PY'
import json
import os
import socket
import sys

wanted = [
    "WHISPER_LANGUAGE",
    "WHISPER_LANGS",
    "WHISPER_MODEL",
    "WHISPER_BEAM_SIZE",
    "WHISPER_DUAL",
    "WHISPER_MIN_SCORE",
    "WHISPER_VAD",
    "DICT_PATH",
    "CORRECTIONS_PATH",
    "WHISPER_LOG_PATH",
    "WHISPER_FAILED_DIR",
]
env = {key: os.environ[key] for key in wanted if key in os.environ}
env.update(
    {
        "WHISPER_DUAL": "0",
        "WHISPER_BEAM_SIZE": "1",
        "WHISPER_MIN_SCORE": "1",
        "WHISPER_TAIL_SECONDS": os.environ.get("WHISPER_PARTIAL_TAIL", "8"),
        "WHISPER_LOG_PATH": "/dev/null",
        "WHISPER_FAILED_DIR": "",
        "TXT_PATH": "/dev/null",
    }
)
request = {"wav": os.environ["WAV_REQUEST"], "env": env}
try:
    client = socket.socket(socket.AF_UNIX)
    client.settimeout(120)
    client.connect(os.environ["WHISPR_SOCK"])
    client.sendall((json.dumps(request) + "\n").encode("utf-8"))
    inbox = b""
    while not inbox.endswith(b"\n"):
        chunk = client.recv(65536)
        if not chunk:
            break
        inbox += chunk
    reply = json.loads(inbox.decode("utf-8"))
    if "error" in reply:
        raise SystemExit(1)
    print(reply.get("text") or "", end="")
except Exception:
    raise SystemExit(1)
PY
}

partial_loop() {
  local wav="$1"
  local text preview
  for _ in 1 2 3; do
    daemon_probe && break
    sleep 2
  done
  daemon_probe || return 0
  while :; do
    sleep "${WHISPER_PARTIAL_INTERVAL:-3.5}"
    [[ -f "$pid_file" ]] || return 0
    [[ -s "$wav" ]] || continue
    text="$(asr_partial "$wav" 2>/dev/null)" || continue
    [[ -z "$text" ]] && continue
    preview="$text"
    if (( ${#preview} > 160 )); then
      preview="${preview: -160}"
    fi
    notify_status "Whispr Flow" "≈ ${preview}" "listening" 4000
  done
}

start_partial_loop() {
  if [[ "${WHISPER_PARTIALS:-1}" == "0" ]]; then
    return 0
  fi
  (
    partial_loop "$wav_file" >/dev/null 2>&1
  ) &
  echo $! >"$partials_pid_file"
}

