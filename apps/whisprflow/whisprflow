  WHISPER_MIN_SCORE="${WHISPER_MIN_SCORE:--0.47}" \
  WHISPER_VAD="${WHISPER_VAD:-1}" \
  WHISPER_LANGS="${WHISPER_LANGS:-pl,en}" \
  WHISPER_LANGUAGE="${WHISPER_LANGUAGE:-}" \
  DICT_PATH="$dict_file" \
  CORRECTIONS_PATH="$corrections_file" \
  WHISPER_LOG_PATH="$data_dir/whisper.log" \
  WHISPER_FAILED_DIR="$data_dir/failed" \
  WHISPER_STATS_PATH="$stats_file" \
  python3 - <<'PY'
import os
import sys

sys.path.insert(0, os.environ["WHISPR_ASR_DIR"])
import asr

asr.transcribe_file(os.environ["WAV_PATH"])
PY
}

stop_recording() {
  local pid
  pid=$(cat "$pid_file" 2>/dev/null || true)
  stop_partials
  if [[ -z "${pid:-}" ]]; then
    rm -f "$pid_file"
    return 1
  fi

  kill -INT "$pid" 2>/dev/null || true

  # Wait for arecord to exit
  for _ in $(seq 1 100); do
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done

  rm -f "$pid_file"

  {
    echo "stop_time: $(date -Is)"
    echo "backend: $(cat "$backend_file" 2>/dev/null || echo unknown)"
    echo "raw_size: $(stat -c '%s' "$raw_file" 2>/dev/null || echo 0)"
    echo "wav_size: $(stat -c '%s' "$wav_file" 2>/dev/null || echo 0)"
  } >>"$record_log" 2>/dev/null || true

  if [[ -s "$raw_file" ]]; then
    RAW_PATH="$raw_file" WAV_PATH="$wav_file" WHISPER_RATE=16000 WHISPER_CHANNELS=1 python3 - <<'PY'
import os
import wave
from pathlib import Path

raw_path = Path(os.environ["RAW_PATH"])
wav_path = Path(os.environ["WAV_PATH"])
rate = int(os.environ.get("WHISPER_RATE", "16000"))
channels = int(os.environ.get("WHISPER_CHANNELS", "1"))

data = raw_path.read_bytes()
if not data:
    wav_path.write_bytes(b"")
    raise SystemExit(0)

with wave.open(str(wav_path), "wb") as wf:
    wf.setnchannels(channels)
    wf.setsampwidth(2)  # s16le
    wf.setframerate(rate)
    wf.writeframes(data)
PY
  fi

  if [[ ! -s "$wav_file" ]]; then
    hide_indicator
    flash_indicator "Whispr Flow" "No audio captured." "error" 2200
    return 1
  fi
  if [[ $(stat -c '%s' "$wav_file") -lt 1024 ]]; then
    flash_indicator "Whispr Flow" "Audio too short or silent. Check mic input/mute." "error" 2200
  fi

  show_indicator "Whispr Flow" "Transcribing..." "working" 0

  log_file="$state_dir/last-error.log"

  if ! asr_transcribe "$wav_file" 2>"$log_file"; then
    hide_indicator
    flash_indicator "Whispr Flow" "Transcription failed. See $log_file" "error" 2600
    return 1
  fi

  if [[ ! -s "$txt_file" ]]; then
    hide_indicator
    flash_indicator "Whispr Flow" "No speech detected." "error" 2200
    return 1
  fi

  if [[ "${WHISPER_SPARK_CORRECTION:-1}" != "0" ]] && command -v spark-corrector >/dev/null 2>&1; then
    show_indicator "Whispr Flow" "Spark cleanup..." "working" 0
    spark_out="$state_dir/spark-corrected.txt"
    if spark-corrector filter --mode whisprflow <"$txt_file" >"$spark_out" 2>"$state_dir/spark.err" \
      && [[ -s "$spark_out" ]]; then
      mv "$spark_out" "$txt_file"
    else
      flash_indicator "Whispr Flow" "Spark cleanup failed; using raw transcript." "error" 2400
    fi
  fi

  transcript_before_review="$(cat "$txt_file" 2>/dev/null || true)"
  focused_window="$(capture_active_window)"

  if [[ "${WHISPER_REVIEW:-0}" == "1" ]] && [[ -n "$transcript_before_review" ]]; then
    hide_indicator
    if reviewed_text="$(review_text_popup "$transcript_before_review")"; then
      reviewed_text="${reviewed_text%$'\n'}"
      printf '%s' "$reviewed_text" >"$txt_file"
      learn_from_pair "$transcript_before_review" "$reviewed_text"
    else
      if [[ -s "$review_err" ]]; then
        flash_indicator "Whispr Flow" "Review UI failed, using raw transcript." "error" 2600
      else
        flash_indicator "Whispr Flow" "Review cancelled." "error" 1800
        return 1
      fi
    fi
    refocus_window "$focused_window"
    sleep 0.2
  fi

  deliver_transcript
}

deliver_transcript() {
  if ! wl-copy < "$txt_file"; then
    flash_indicator "Whispr Flow" "Clipboard copy failed." "error" 2200
  fi

  paste_ok=0
  sleep 0.2 # Give Hyprland time to restore focus and wl-copy to own the selection.

  if [[ "${WHISPER_PASTE_MODE:-type}" == "type" ]]; then
    # Type the transcript directly into the focused window, like Wispr Flow.
    # Avoids clobbering the user's clipboard when possible.
    if command -v wtype >/dev/null 2>&1 && wtype -s 15 -- "$(cat "$txt_file")" 2>/dev/null; then
      paste_ok=1
    fi
  fi

  if [[ $paste_ok -eq 0 ]]; then
    if command -v ydotool >/dev/null 2>&1; then
      # Paste through the target application's clipboard handling. `ydotool type`
      # maps characters to key codes and cannot reliably emit Polish Unicode.
      if ydotool key 29:1 47:1 47:0 29:0 2>/dev/null; then
        paste_ok=1
      fi
    fi

    if [[ $paste_ok -eq 0 ]] && command -v wtype >/dev/null 2>&1; then
      for _ in 1 2 3; do
        wtype -M ctrl -k v -m ctrl 2>/dev/null && {
          paste_ok=1
          break
        }
      done
    fi
  fi

  if [[ $paste_ok -eq 0 ]]; then
    flash_indicator "Whispr Flow" "Paste shortcut failed. The text remains in the clipboard." "error" 2400
  fi

  # Learn from a corrected clipboard within 10 minutes.
  ensure_learn_script
  (
    transcript="$(cat "$txt_file" 2>/dev/null || true)"
    once_file="$state_dir/learn.once"
    rm -f "$once_file"
    # Variables in the single-quoted script expand in the child Bash process.
    # shellcheck disable=SC2016
    TRANSCRIPT="$transcript" DICT_PATH="$dict_file" CORRECTIONS_PATH="$corrections_file" DICT_LOG="$dict_log" LEARN_SCRIPT="$learn_script" ONCE_FILE="$once_file" \
      timeout 600s wl-paste --watch --type text/plain --no-newline bash -c '
        clip=$(cat)
        if [ -f "$ONCE_FILE" ]; then
          exit 0
        fi
        [ -z "$clip" ] && exit 0
        [ "$clip" = "$TRANSCRIPT" ] && exit 0
        touch "$ONCE_FILE"
        CLIP="$clip" python3 "$LEARN_SCRIPT"
      ' >/dev/null 2>&1 || true
  ) &

  flash_indicator "Whispr Flow" "Pasted. Edits you make here can still be learned automatically." "success" 1800
}

start_recording() {
  cleanup_stale_pid

  if [[ -f "$pid_file" ]]; then
    # Recording already running
    return 0
  fi

  rm -f "$raw_file" "$wav_file" "$txt_file" "$backend_file" "$record_err"

  {
    echo "start_time: $(date -Is)"
  } >"$record_log" 2>/dev/null || true

  show_indicator "Whispr Flow" "Checking microphone..." "working" 0
  if ! source_name="$(select_record_source)"; then
    hide_indicator
    flash_indicator "Whispr Flow" "No working microphone source found." "error" 2600
    return 1
  fi
  ensure_source_unmuted "$source_name"
  warmup_asr
  start_partial_loop
  {
    echo "source: $source_name"
  } >>"$record_log" 2>/dev/null || true
  show_indicator "Whispr Flow" "Listening... Release Pause to stop." "listening" 0
  if command -v pw-record >/dev/null 2>&1; then
    echo "pw-record" > "$backend_file"
    if [[ -n "${source_name:-}" ]]; then
      pw-record --rate 16000 --channels 1 --format s16 --target "$source_name" "$wav_file" 2>"$record_err" &
    else
      pw-record --rate 16000 --channels 1 --format s16 "$wav_file" 2>"$record_err" &
    fi
  elif command -v parec >/dev/null 2>&1; then
    echo "parec" > "$backend_file"
    if [[ -n "${source_name:-}" ]]; then
      parec -d "$source_name" --format=s16le --rate=16000 --channels=1 >"$raw_file" 2>"$record_err" &
    else
      parec --format=s16le --rate=16000 --channels=1 >"$raw_file" 2>"$record_err" &
    fi
  else
    echo "arecord" > "$backend_file"
    arecord -q -f S16_LE -r 16000 -c 1 "$wav_file" 2>"$record_err" &
  fi
  echo $! > "$pid_file"
}

copy_last_transcript() {
  local transcript

  transcript="$(cat "$txt_file" 2>/dev/null || true)"
  if [[ -z "$transcript" ]]; then
    echo "No recent transcript to copy." >&2
    notify_whisper "WhisprFlow" "No recent transcript to copy."
    return 1
  fi

  printf '%s' "$transcript" | wl-copy
  echo "Copied the last transcript to the clipboard."
  notify_whisper "WhisprFlow" "Copied the last transcript to the clipboard."
}

print_status() {
  if [[ -f "$pid_file" ]]; then
    echo "recording"
  else
    echo "idle"
  fi
  if daemon_probe; then
    echo "daemon: ready (model ${WHISPER_MODEL:-large-v3-turbo})"
  else
    echo "daemon: cold (model ${WHISPER_MODEL:-large-v3-turbo})"
  fi
}

cancel_recording() {
  local pid
  stop_partials
  pid=$(cat "$pid_file" 2>/dev/null || true)
  if [[ -z "${pid:-}" ]]; then
    rm -f "$pid_file"
    notify_whisper "WhisprFlow" "Nothing to cancel."
    return 1
  fi

  kill -INT "$pid" 2>/dev/null || true
  for _ in $(seq 1 60); do
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  rm -f "$pid_file" "$raw_file" "$wav_file" "$txt_file" "$record_err"
  hide_indicator
  flash_indicator "Whispr Flow" "Recording cancelled." "success" 1600
}

review_last() {
  local transcript focused_window
  transcript="$(cat "$txt_file" 2>/dev/null || true)"
  if [[ -z "$transcript" ]]; then
    notify_whisper "WhisprFlow" "No recent transcript to review."
    return 1
  fi

  focused_window="$(capture_active_window)"
  if reviewed_text="$(review_text_popup "$transcript")"; then
    reviewed_text="${reviewed_text%$'\n'}"
    printf '%s' "$reviewed_text" >"$txt_file"
    learn_from_pair "$transcript" "$reviewed_text"
  else
    notify_whisper "WhisprFlow" "Review cancelled."
    return 1
  fi
  refocus_window "$focused_window"
  sleep 0.2
  deliver_transcript
}

dict_command() {
  local action="${1:-list}" term
  shift || true
  term="${*:-(missing)}"

  case "$action" in
    add)
      if [[ -z "$term" || "$term" == "missing" ]]; then
        echo "Usage: whisprflow dict add TERM [expansion]" >&2
        return 2
      fi
      grep -Fxq "$term" "$dict_file" 2>/dev/null || {
        if [[ -s "$dict_file" ]] && [[ "$(tail -c 1 "$dict_file")" != $'\n' ]]; then
          printf '\n' >>"$dict_file"
        fi
        printf '%s\n' "$term" >>"$dict_file"
      }
      sort -o "$dict_file" "$dict_file"
      echo "Dictionary now has $(wc -l <"$dict_file") entries."
      ;;
    remove)
      if [[ ! -s "$dict_file" ]]; then
        echo "Dictionary is empty." >&2
        return 1
      fi
      grep -Fxv "$term" "$dict_file" >"$dict_file.tmp"
      mv "$dict_file.tmp" "$dict_file"
      echo "Dictionary now has $(( $(wc -l <"$dict_file") )) entries."
      ;;
    clear)
      : >"$dict_file"
      echo "Dictionary cleared."
      ;;
    list)
      cat "$dict_file" 2>/dev/null || true
      ;;
    *)
      echo "Usage: whisprflow dict [add TERM | remove TERM | clear | list]" >&2
      return 2
      ;;
  esac
}

print_stats() {
  [[ -s "$stats_file" ]] || { echo "No stats yet. Dictate something first."; return 0; }
  python3 - "$stats_file" <<'PY'
import json
import sys
from datetime import datetime, timedelta
from pathlib import Path


def parse(stamp):
    return datetime.strptime(stamp, "%Y%m%d-%H%M%S") if stamp else None

entries = []
for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
    line = line.strip()
    if not line:
        continue
    try:
        entry = json.loads(line)
    except ValueError:
        continue
    entries.append(entry)
if not entries:
    print("No stats yet. Dictate something first.")
    raise SystemExit

now = datetime.now()
buckets = {"today": timedelta(days=1), "week": timedelta(days=7), "all": None}
print("span     words  sessions  dictation-min")
for label, delta in buckets.items():
    subset = [
        e for e in entries
        if delta is None or (parse(e.get("t")) or now) >= now - delta
    ]
    words = sum(int(e.get("words", 0)) for e in subset)
    minutes = sum(float(e.get("durationS", 0)) for e in subset) / 60
    print(f"{label:<8}{words:>7}{len(subset):>10}{minutes:>15.1f}")
PY
}

print_usage() {
  cat <<EOF
Usage: whisprflow COMMAND [args]

  start                          Start recording
  stop                           Stop, transcribe, (Spark) clean up, and paste
  toggle                         Start or stop recording
  cancel                         Stop recording and discard the draft
  review                         Re-edit the last transcript and re-paste it
  status                         Print recording/idle plus daemon state
  copy                           Copy the last transcript to the clipboard
  learn                          Learn from the last transcript and clipboard
  dict [add|remove|clear|list]   Manage dictionary entries
  stats                          Dictation statistics (words, sessions)
EOF
}

cleanup_stale_pid

case "${1:-toggle}" in
  start)
    start_recording
    ;;
  stop)
    stop_recording
    ;;
  cancel)
    cancel_recording
    ;;
  review)
    review_last
    ;;
  status)
    print_status
    ;;
  copy)
    copy_last_transcript
    ;;
  dict)
    dict_command "${2:-list}" "${@:3}"
    ;;
  stats)
    print_stats
    ;;
  learn)
    ensure_learn_script
    transcript="$(cat "$txt_file" 2>/dev/null || true)"
    clip="$(wl-paste --no-newline 2>/dev/null || true)"
    if [[ -z "$transcript" ]]; then
      notify_whisper "WhisprFlow" "No recent transcript to learn from."
      exit 1
    fi
    if [[ -z "$clip" ]] || [[ "$clip" == "$transcript" ]]; then
      notify_whisper "WhisprFlow" "Copy your corrected text first, then run learn."
      exit 1
    fi
    TRANSCRIPT="$transcript" CLIP="$clip" DICT_PATH="$dict_file" CORRECTIONS_PATH="$corrections_file" DICT_LOG="$dict_log" python3 "$learn_script"
    notify_whisper "WhisprFlow" "Learned from your corrected text."
    ;;
  toggle)
    if [[ -f "$pid_file" ]]; then
      stop_recording
    else
      start_recording
    fi
    ;;
  help | -h | --help)
    print_usage
    ;;
  *)
    print_usage >&2
    exit 2
    ;;
esac
