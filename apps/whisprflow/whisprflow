#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
state_dir="${WHISPR_STATE_DIR:-$runtime_dir/whisper-record-v2}"
data_dir="${WHISPR_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/whisper-record-v2}"
pid_file="$state_dir/record.pid"
raw_file="$state_dir/record.raw"
wav_file="$state_dir/record.wav"
txt_file="$state_dir/record.txt"
dict_file="$data_dir/dict.txt"
corrections_file="$data_dir/corrections.tsv"
source_cache_file="$data_dir/record-source"
learn_script="$state_dir/learn.py"
backend_file="$state_dir/backend"
record_log="$state_dir/last-record.log"
record_err="$state_dir/record.err"
dict_log="$data_dir/dict.log"
review_err="$state_dir/review.err"
indicator_pid_file="$state_dir/indicator.pid"
review_css_file="$state_dir/review.css"
notification_id_file="$state_dir/notification.id"
asr_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")" && pwd)"
asr_py="$asr_dir/asr.py"
serve_sock="$state_dir/serve.sock"
serve_log="$state_dir/serve.log"
partials_pid_file="$state_dir/partials.pid"
stats_file="$data_dir/stats.jsonl"

mkdir -p "$state_dir"
mkdir -p "$data_dir"

notify_whisper() {
  notify-send "$@" >/dev/null 2>&1 || true
}

whispr_app_name="WhisprFlow"

ensure_ui_css() {
  cat >"$review_css_file" <<'CSS'
window {
  background: #1e1e2e;
  border: 1px solid #45475a;
  border-radius: 10px;
}

label {
  color: #cdd6f4;
}

textview,
textview text,
scrolledwindow,
viewport {
  background: #313244;
  color: #cdd6f4;
  border-radius: 10px;
}

button {
  background: #313244;
  color: #cdd6f4;
  border: 1px solid #45475a;
  border-radius: 10px;
  padding: 8px 14px;
}
CSS
}

notify_status() {
  local title="$1"
  local body="${2:-}"
  local tone="${3:-info}"
  local timeout_ms="${4:-1800}"
  local urgency="normal"
  local icon="dialog-information"
  local replace_id=""
  local notification_id=""

  case "$tone" in
    listening)
      urgency="low"
      icon="audio-input-microphone"
      ;;
    working)
      urgency="normal"
      icon="system-search"
      ;;
    success)
      urgency="low"
      icon="emblem-ok"
      ;;
    error)
      urgency="critical"
      icon="dialog-error"
      ;;
    *)
      urgency="normal"
      icon="dialog-information"
      ;;
  esac

  if [[ -f "$notification_id_file" ]]; then
    replace_id="$(cat "$notification_id_file" 2>/dev/null || true)"
  fi

  if command -v notify-send >/dev/null 2>&1; then
    if [[ -n "$replace_id" ]]; then
      notification_id="$(
        notify-send \
          -a "$whispr_app_name" \
          -p \
          -r "$replace_id" \
          -e \
          -u "$urgency" \
          -t "$timeout_ms" \
          -i "$icon" \
          "$title" \
          "$body" 2>/dev/null || true
      )"
    else
      notification_id="$(
        notify-send \
          -a "$whispr_app_name" \
          -p \
          -e \
          -u "$urgency" \
          -t "$timeout_ms" \
          -i "$icon" \
          "$title" \
          "$body" 2>/dev/null || true
      )"
    fi
  fi

  if [[ "$notification_id" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$notification_id" >"$notification_id_file"
  fi
}

hide_indicator() {
  local pid
  pid="$(cat "$indicator_pid_file" 2>/dev/null || true)"
  if [[ -n "${pid:-}" ]]; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$indicator_pid_file"

  rm -f "$notification_id_file"
}

start_spinner_indicator() {
  local title="$1"
  local body="${2:-}"
  local tone="${3:-info}"
  hide_indicator
  (
    local frames=("|" "/" "-" "\\")
    local i=0
    while true; do
      notify_status "${frames[i]} $title" "$body" "$tone" 1200
      i=$(( (i + 1) % ${#frames[@]} ))
      sleep 0.12
    done
  ) >/dev/null 2>>"$review_err" &
  echo $! >"$indicator_pid_file"
}

show_indicator() {
  local title="$1"
  local body="${2:-}"
  local tone="${3:-info}"
  local timeout_ms="${4:-0}"

  if [[ "$timeout_ms" =~ ^[0-9]+$ ]] && [[ "$timeout_ms" -eq 0 ]]; then
    start_spinner_indicator "$title" "$body" "$tone"
    return 0
  fi

  hide_indicator
  notify_status "$title" "$body" "$tone" "$timeout_ms"
}

flash_indicator() {
  show_indicator "$1" "${2:-}" "${3:-info}" "${4:-1800}"
}

learn_from_pair() {
  local transcript="$1"
  local corrected="$2"
  ensure_learn_script

  [[ -z "$transcript" || -z "$corrected" || "$transcript" == "$corrected" ]] && return 0

  TRANSCRIPT="$transcript" \
    CLIP="$corrected" \
    DICT_PATH="$dict_file" \
    CORRECTIONS_PATH="$corrections_file" \
    DICT_LOG="$dict_log" \
    python3 "$learn_script" >/dev/null 2>&1 || true
}

