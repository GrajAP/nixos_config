{
  "manifest_version": 3,
  "name": "T3 Gate",
  "version": "1.0.0",
  "description": "Blokuje wybrane strony (YouTube, X itd.), dopóki na grajpap, lenovo ani dell nie działa żaden agent T3 Code.",
  "key": "",
  "permissions": ["storage", "tabs", "webNavigation", "alarms"],
