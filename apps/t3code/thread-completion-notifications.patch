+++ b/apps/web/src/threadCompletionNotifications.logic.ts
@@ -0,0 +1,52 @@
+export type ThreadTurnState = "running" | "interrupted" | "completed" | "error";
+
+export interface ThreadTurnObservation {
+  readonly threadKey: string;
+  readonly threadTitle: string;
+  readonly turnId: string;
+  readonly state: ThreadTurnState;
+}
+
+export interface ThreadCompletionNotification {
+  readonly threadKey: string;
+  readonly threadTitle: string;
+  readonly turnId: string;
+  readonly outcome: "completed" | "error";
+}
+
+export interface ThreadCompletionObservationResult {
+  readonly currentTurns: ReadonlyMap<string, ThreadTurnObservation>;
+  readonly notifications: ReadonlyArray<ThreadCompletionNotification>;
+}
+
+export function observeThreadTurnCompletions(
+  previousTurns: ReadonlyMap<string, ThreadTurnObservation>,
+  currentThreads: ReadonlyArray<ThreadTurnObservation>,
+): ThreadCompletionObservationResult {
+  const currentTurns = new Map<string, ThreadTurnObservation>();
+  const notifications: ThreadCompletionNotification[] = [];
+
+  for (const current of currentThreads) {
+    currentTurns.set(current.threadKey, current);
+    const previous = previousTurns.get(current.threadKey);
+    if (
+      previous?.turnId !== current.turnId ||
+      previous.state !== "running" ||
+      (current.state !== "completed" && current.state !== "error")
+    ) {
+      continue;
+    }
+
+    notifications.push({
+      threadKey: current.threadKey,
+      threadTitle: current.threadTitle,
+      turnId: current.turnId,
+      outcome: current.state,
+    });
+  }
+
+  return {
+    currentTurns,
+    notifications,
+  };
+}
