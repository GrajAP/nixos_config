diff --git a/apps/web/src/components/ThreadCompletionNotifications.tsx b/apps/web/src/components/ThreadCompletionNotifications.tsx
new file mode 100644
index 0000000..3f10a9a
--- /dev/null
+++ b/apps/web/src/components/ThreadCompletionNotifications.tsx
@@ -0,0 +1,80 @@
+import { scopedThreadKey, scopeThreadRef } from "@t3tools/client-runtime/environment";
+import { useEffect, useRef } from "react";
+
+import { isElectron } from "../env";
+import { useThreadShells } from "../state/entities";
+import {
+  observeThreadTurnCompletions,
+  type ThreadTurnObservation,
+} from "../threadCompletionNotifications.logic";
+
+function canShowNotifications(): boolean {
+  return isElectron && "Notification" in window;
+}
+
+function requestNotificationPermission(): void {
+  if (!canShowNotifications() || Notification.permission !== "default") {
+    return;
+  }
+
+  void Notification.requestPermission();
+}
+
+function showThreadCompletionNotification(
+  completion: ReturnType<typeof observeThreadTurnCompletions>["notifications"][number],
+): void {
+  if (!canShowNotifications() || Notification.permission !== "granted") {
+    return;
+  }
+
+  const completed = completion.outcome === "completed";
+  const notification = new Notification(
+    completed ? "T3 Code finished" : "T3 Code stopped",
+    {
+      body: completed
+        ? `"${completion.threadTitle}" is ready for the next message.`
+        : `"${completion.threadTitle}" stopped with an error.`,
+      tag: `t3code-thread-${completion.threadKey}`,
+    },
+  );
+  notification.onclick = () => {
+    window.focus();
+    notification.close();
+  };
+}
+
+export function ThreadCompletionNotifications() {
+  const threads = useThreadShells();
+  const previousTurnsRef = useRef<ReadonlyMap<string, ThreadTurnObservation>>(new Map());
+
+  useEffect(() => {
+    requestNotificationPermission();
+  }, []);
+
+  useEffect(() => {
+    const result = observeThreadTurnCompletions(
+      previousTurnsRef.current,
+      threads.flatMap((thread): ThreadTurnObservation[] => {
+        if (!thread.latestTurn) {
+          return [];
+        }
+
+        return [
+          {
+            threadKey: scopedThreadKey(scopeThreadRef(thread.environmentId, thread.id)),
+            threadTitle: thread.title,
+            turnId: thread.latestTurn.turnId,
+            state: thread.latestTurn.state,
+          },
+        ];
+      }),
+    );
+    previousTurnsRef.current = result.currentTurns;
+
+    for (const completion of result.notifications) {
+      showThreadCompletionNotification(completion);
+    }
+  }, [threads]);
+
+  return null;
+}
