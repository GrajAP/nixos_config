diff --git a/apps/web/src/threadCompletionNotifications.logic.test.ts b/apps/web/src/threadCompletionNotifications.logic.test.ts
new file mode 100644
index 0000000..49abd0d
--- /dev/null
+++ b/apps/web/src/threadCompletionNotifications.logic.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from "@effect/vitest";
+
+import {
+  observeThreadTurnCompletions,
+  type ThreadTurnObservation,
+} from "./threadCompletionNotifications.logic";
+
+function observation(
+  state: ThreadTurnObservation["state"],
+  overrides: Partial<ThreadTurnObservation> = {},
+): ThreadTurnObservation {
+  return {
+    threadKey: "environment-1:thread-1",
+    threadTitle: "Restore queued messages",
+    turnId: "turn-1",
+    state,
+    ...overrides,
+  };
+}
+
+describe("thread completion notifications", () => {
+  it("uses the first snapshot as a baseline without notifying for old turns", () => {
+    const result = observeThreadTurnCompletions(new Map(), [observation("completed")]);
+
+    expect(result.notifications).toEqual([]);
+    expect(result.currentTurns.get("environment-1:thread-1")).toEqual(observation("completed"));
+  });
+
+  it("notifies once when an observed running turn completes", () => {
+    const running = observation("running");
+    const previous = new Map([[running.threadKey, running]]);
+
+    const completed = observeThreadTurnCompletions(previous, [observation("completed")]);
+
+    expect(completed.notifications).toEqual([
+      {
+        threadKey: running.threadKey,
+        threadTitle: running.threadTitle,
+        turnId: running.turnId,
+        outcome: "completed",
+      },
+    ]);
+
+    const duplicate = observeThreadTurnCompletions(completed.currentTurns, [
+      observation("completed"),
+    ]);
+    expect(duplicate.notifications).toEqual([]);
+  });
+
+  it("reports errors but ignores deliberate interruptions", () => {
+    const first = observation("running", {
+      threadKey: "environment-1:error-thread",
+      turnId: "turn-error",
+    });
+    const second = observation("running", {
+      threadKey: "environment-1:interrupted-thread",
+      turnId: "turn-interrupted",
+    });
+    const previous = new Map([
+      [first.threadKey, first],
+      [second.threadKey, second],
+    ]);
+
+    const result = observeThreadTurnCompletions(previous, [
+      { ...first, state: "error" },
+      { ...second, state: "interrupted" },
+    ]);
+
+    expect(result.notifications).toEqual([
+      {
+        threadKey: first.threadKey,
+        threadTitle: first.threadTitle,
+        turnId: first.turnId,
+        outcome: "error",
+      },
+    ]);
+  });
+
+  it("does not confuse a newer turn with the running turn it replaced", () => {
+    const running = observation("running");
+    const previous = new Map([[running.threadKey, running]]);
+
+    const result = observeThreadTurnCompletions(previous, [
+      observation("completed", { turnId: "turn-2" }),
+    ]);
+
+    expect(result.notifications).toEqual([]);
+  });
+});
diff --git a/apps/web/src/threadCompletionNotifications.logic.ts b/apps/web/src/threadCompletionNotifications.logic.ts
new file mode 100644
