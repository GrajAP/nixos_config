--- a/apps/web/src/threadMessageQueue.test.ts	1970-01-01 01:00:00.000000000 +0100
+++ b/apps/web/src/threadMessageQueue.test.ts	2026-08-06 22:19:38.546070843 +0200
@@ -0,0 +1,87 @@
+import { describe, expect, it } from "@effect/vitest";
+import { EnvironmentId, MessageId, ProviderInstanceId, ThreadId } from "@t3tools/contracts";
+
+import {
+  enqueueThreadMessage,
+  queuedMessagesForThread,
+  removeQueuedThreadMessage,
+  type QueuedThreadMessage,
+} from "./threadMessageQueue";
+
+function queuedMessage(input: {
+  messageId: string;
+  createdAt: string;
+  environmentId?: string;
+  threadId?: string;
+}): QueuedThreadMessage {
+  return {
+    environmentId: EnvironmentId.make(input.environmentId ?? "environment-1"),
+    threadId: ThreadId.make(input.threadId ?? "thread-1"),
+    messageId: MessageId.make(input.messageId),
+    displayText: input.messageId,
+    text: input.messageId,
+    attachments: [],
+    modelSelection: {
+      instanceId: ProviderInstanceId.make("codex"),
+      model: "gpt-5.4",
+    },
+    runtimeMode: "full-access",
+    interactionMode: "default",
+    createdAt: input.createdAt,
+  };
+}
+
+describe("thread message queue", () => {
+  it("keeps FIFO order and deduplicates message ids", () => {
+    const later = queuedMessage({
+      messageId: "message-2",
+      createdAt: "2026-07-16T10:00:02.000Z",
+    });
+    const earlier = queuedMessage({
+      messageId: "message-1",
+      createdAt: "2026-07-16T10:00:01.000Z",
+    });
+
+    const queued = enqueueThreadMessage(enqueueThreadMessage([later], earlier), earlier);
+
+    expect(queued).toEqual([earlier, later]);
+  });
+
+  it("scopes queues to an environment and thread", () => {
+    const selected = queuedMessage({
+      messageId: "selected",
+      createdAt: "2026-07-16T10:00:01.000Z",
+    });
+    const otherThread = queuedMessage({
+      messageId: "other-thread",
+      threadId: "thread-2",
+      createdAt: "2026-07-16T10:00:02.000Z",
+    });
+    const otherEnvironment = queuedMessage({
+      messageId: "other-environment",
+      environmentId: "environment-2",
+      createdAt: "2026-07-16T10:00:03.000Z",
+    });
+
+    expect(
+      queuedMessagesForThread(
+        [otherEnvironment, selected, otherThread],
+        selected.environmentId,
+        selected.threadId,
+      ),
+    ).toEqual([selected]);
+  });
+
+  it("removes only the selected queued message", () => {
+    const first = queuedMessage({
+      messageId: "message-1",
+      createdAt: "2026-07-16T10:00:01.000Z",
+    });
+    const second = queuedMessage({
+      messageId: "message-2",
+      createdAt: "2026-07-16T10:00:02.000Z",
+    });
+
+    expect(removeQueuedThreadMessage([first, second], first.messageId)).toEqual([second]);
+  });
+});
